# Docker Hub Configuration
# Replace 'yourusername' with your actual Docker Hub username
DOCKERHUB_USERNAME=yourusername

# Site Configuration
SITE_NAME=DevOps Monitoring Dashboard
SITE_URL=http://localhost:3000
SITE_DESCRIPTION=Comprehensive DevOps monitoring solution with real-time metrics, centralized logging, and intelligent alerting.

# Database Configuration
DATABASE_URL=postgresql://observability_app:observability_dev_password@localhost:5434/observability_dev?schema=public
DB_PORT=5434
DB_NAME=observability_dev
DB_USER=observability_app
DB_PASSWORD=observability_dev_password

# Authentication Configuration
# NEXTAUTH_SECRET=your-secret-key-here
# NEXTAUTH_URL=http://localhost:3000

# Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
