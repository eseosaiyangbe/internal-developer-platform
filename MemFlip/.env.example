# Root Docker Compose environment contract for MemFlip.
# Copy this file to .env in the repo root before local startup.
#
# Notes:
# - The more detailed reference remains in env/env.example.
# - These values are chosen for the local Compose path and are intended to
#   translate cleanly into future Kubernetes ConfigMaps and Secrets.

NODE_ENV=development

# Published host ports
FRONTEND_HOST_PORT=8080
API_PORT=3001

# Frontend/API routing
API_BASE_URL=/api
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# PostgreSQL
DB_NAME=humor_memory_game
DB_USER=gameuser
DB_PASSWORD=your_database_password_here

# Redis
REDIS_PASSWORD=your_redis_password_here

# Application secrets
JWT_SECRET=your-super-secret-jwt-key-change-this
