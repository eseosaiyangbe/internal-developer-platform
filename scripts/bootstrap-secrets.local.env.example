# Local dev secrets for scripts/bootstrap-k3s-vault-secrets.sh
#
# Copy this file to scripts/bootstrap-secrets.local.env, fill in the values,
# and keep that copy OUT of git (it is gitignored). Recommended: chmod 600.
#
# The bootstrap script fails fast if the file or any of these variables
# is missing. Prod credentials are not listed here on purpose: the script
# generates them with openssl at bootstrap time.
#
# To recover the current dev values from the previous version of the
# bootstrap script in git history, run this from the repo root:
#   git show HEAD~1:scripts/bootstrap-k3s-vault-secrets.sh | grep -E '^[A-Z_]+_DEV_[A-Z_]*=' > scripts/bootstrap-secrets.local.env
# (adjust HEAD~1 if more commits have landed since; then chmod 600 the file)

MEMFLIP_DEV_DB_PASSWORD=
MEMFLIP_DEV_REDIS_PASSWORD=
MEMFLIP_DEV_JWT_SECRET=

SWIFTPAY_DEV_DB_PASSWORD=
SWIFTPAY_DEV_RABBITMQ_PASSWORD=
SWIFTPAY_DEV_JWT_SECRET=

FOODPULSE_DEV_DB_PASSWORD=
FOODPULSE_DEV_REDIS_PASSWORD=
FOODPULSE_DEV_REDIS_SENTINEL_PASSWORD=

OPENSIS_DEV_DB_PASSWORD=
OPENSIS_DEV_DB_ROOT_PASSWORD=
OPENSIS_DEV_MYSQL_EXPORTER_PASSWORD=

OBSERVABILITY_DEV_DB_PASSWORD=
OBSERVABILITY_DEV_NEXTAUTH_SECRET=
OBSERVABILITY_DEV_GRAFANA_ADMIN_PASSWORD=
